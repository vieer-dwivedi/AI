# Copy this file to .env and add your real API key.
# Never commit .env or put real credentials in this sample file.

# LLM provider
MODEL_NAME=llama-3.3-70b-versatile
MODEL_PROVIDER=groq
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=2048
MODEL_MAX_RETRIES=2

# API key for the selected provider (Groq when MODEL_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# For Google Gemini instead, set MODEL_PROVIDER=google_genai,
# choose a Gemini model in MODEL_NAME, and configure:
# GOOGLE_API_KEY=your_google_api_key_here

# Dasha MCP server
DASHA_MCP_HOST=127.0.0.1
DASHA_MCP_PORT=8000
DASHA_MCP_URL=http://127.0.0.1:8000/mcp
DASHA_PLAN_LLM=1
DASHA_VERIFY_LLM=1

# Transit MCP server
TRANSIT_MCP_HOST=127.0.0.1
TRANSIT_MCP_PORT=8001
TRANSIT_MCP_URL=http://127.0.0.1:8001/mcp
TRANSIT_PLAN_LLM=1
TRANSIT_VERIFY_LLM=1

# KP MCP server
KP_MCP_HOST=127.0.0.1
KP_MCP_PORT=8002
KP_MCP_URL=http://127.0.0.1:8002/mcp
KP_PLAN_LLM=1
KP_VERIFY_LLM=1

# DBA MCP server
DBA_MCP_HOST=127.0.0.1
DBA_MCP_PORT=8003
