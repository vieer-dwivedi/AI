# =============================================================================
# DispatchAgent .gitignore
# =============================================================================

# --- Secrets & environment (NEVER commit these) ------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
service-account*.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Testing, coverage, linting caches ---------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
dmypy.json

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Project runtime data (generated, reproducible via `python data/seed.py`) -
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/chroma/
chroma/
.chroma/
data/contracts/*.pdf
data/emails/generated/

# --- Agent traces, logs & eval output ----------------------------------------
traces/
*.jsonl
logs/
*.log
evals/reports/*
!evals/reports/.gitkeep
.cache/

# --- Embedding / model caches ------------------------------------------------
.huggingface/
huggingface/
models/
.sentence_transformers/

# --- Streamlit ---------------------------------------------------------------
.streamlit/secrets.toml

# --- Node (in case of any frontend tooling) ----------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker ------------------------------------------------------------------
docker-compose.override.yml
.docker/

# --- IDEs & editors ----------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS junk -----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Temp / backup files -----------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/
