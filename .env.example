# =====================================================================
#  Incident Response Agent - configuration
#  Copy this file to ".env" and edit. Nothing in the code is hard-wired
#  to a specific LLM: change LLM_MODEL and you change the brain.
# =====================================================================

# ---------- LLM (any provider supported by langchain init_chat_model) ----
# Format:  provider:model-name
#   anthropic:claude-sonnet-4-5
#   openai:gpt-4o
#   google_genai:gemini-2.5-flash
#   ollama:llama3.1              (needs: pip install langchain-ollama)
#   groq:llama-3.3-70b-versatile (needs: pip install langchain-groq)
#   bedrock_converse:anthropic.claude-3-5-sonnet-20241022-v2:0
#   fake                         (offline scripted model, for tests only)
LLM_MODEL=fake

# Optional: force a provider if the model name alone is ambiguous
LLM_PROVIDER=
# Optional knobs (leave empty to use provider defaults)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=
LLM_BASE_URL=
LLM_API_KEY=
# Any extra provider kwargs as JSON, e.g. {"region_name":"us-east-1"}
LLM_EXTRA_KWARGS={}

# Optional: use a different model for one sub-agent (empty = use LLM_MODEL)
TRIAGE_LLM_MODEL=
DIAGNOSIS_LLM_MODEL=
REMEDIATION_LLM_MODEL=

# Provider API keys are read directly by LangChain from the environment.
# Fill in only the one(s) you use:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ---------- Embeddings (used by runbook RAG + past-incident memory) -------
# "local-hash" = free, offline, no downloads (good default).
# Or any provider:model, e.g. openai:text-embedding-3-small
EMBEDDINGS_MODEL=local-hash

# ---------- Cloud backend ------------------------------------------------
# mock = reads sample AWS-style data from sample_data/  (safe for testing)
# aws  = calls real AWS APIs with boto3 (needs AWS credentials)
CLOUD_BACKEND=mock
AWS_REGION=us-east-1
# Mock only: restrict the fake "AWS account" to one scenario (empty = all)
MOCK_SCENARIO=
ENABLE_AZURE=false

# ---------- Safety -------------------------------------------------------
# false = agent only PROPOSES fixes. true = execute_remediation may run them.
AUTO_REMEDIATE=false

# ---------- Notifications / webhook --------------------------------------
# Empty = Slack messages are written to out/slack_outbox.jsonl instead
SLACK_WEBHOOK_URL=
# If set, webhook callers must send header  X-Webhook-Secret: <value>
WEBHOOK_SECRET=

# ---------- Storage ------------------------------------------------------
CHROMA_DIR=./data/chroma
OUTPUT_DIR=./out
LOG_LEVEL=INFO

# ---------- Plug in your own MCP servers (optional) ----------------------
# JSON, same shape as langchain-mcp-adapters. Example:
# MCP_SERVERS_JSON={"my-pc":{"transport":"streamable_http","url":"https://host/mcp"}}
MCP_SERVERS_JSON=

# Safety: external MCP tools are ONLY given to the agent if listed here
# (comma separated tool names). Empty = none are attached.
# MCP_TOOL_ALLOWLIST=server_status,my_read_only_tool
MCP_TOOL_ALLOWLIST=
