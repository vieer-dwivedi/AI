# Set these in Vercel -> Project -> Settings -> Environment Variables (and in .env for local runs)
RESUME_SECRET=            # 16+ random chars; MCP URL = https://<your-app>.vercel.app/<RESUME_SECRET>/mcp
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # Google Account -> Security -> App passwords
# Storage: add Upstash Redis from Vercel Marketplace (Storage tab); it injects KV_REST_API_URL / KV_REST_API_TOKEN automatically
# Optional, only for form filling on Vercel (no local browser there): remote browser CDP websocket (Browserless / Browserbase)
BROWSER_WS_ENDPOINT=
# Optional: PUBLIC_BASE_URL=https://your-custom-domain.com  (defaults to the Vercel URL)
